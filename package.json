{
	"name": "pi-zed-provider",
	"version": "0.1.2",
	"type": "module",
	"main": "index.ts",
	"description": "Use a Zed subscription as a native model provider in PI and OMP",
	"license": "MIT",
	"author": "trefeon",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trefeon/Zed2Api.git"
	},
	"homepage": "https://github.com/trefeon/Zed2Api#readme",
	"bugs": {
		"url": "https://github.com/trefeon/Zed2Api/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"omp-plugin",
		"zed",
		"provider",
		"ai",
		"llm"
	],
	"files": [
		"index.ts",
		"src"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"omp": {
		"extensions": [
			"./index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test tests/*.test.ts",
		"pack:check": "npm pack --dry-run"
	},
	"devDependencies": {
		"@oh-my-pi/pi-ai": "^18.12.2",
		"@oh-my-pi/pi-coding-agent": "^18.12.2",
		"@types/bun": "^1.3.2",
		"typescript": "^7.0.2"
	}
}
